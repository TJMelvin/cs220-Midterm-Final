@page "{id}"
@model TylerMelvin_DiscussionBoard.Pages.ProfileIndexModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="container mt-4">

    <a asp-page="/Index" class="btn btn-secondary mt-3">Back</a>

    <div class="card" style="max-width: 500px; margin:auto;">
        <div class="card-body text-center">

            @if (Model.AvatarBase64 != null)
            {
                <img src="@Model.AvatarBase64"
                style="width:120px; height:120px; border-radius:50%; object-fit:cover;" />
            }
            else
            {
                <div style="width:120px; height:120px; border-radius:50%;
                        background:#ccc; display:flex; justify-content:center;
                        align-items:center; font-size:40px;">
                    @Model.Initial    
                </div>
            }

            <h3 class="mt-3">@Model.User.UserName</h3>
            <p class="text-muted">@Model.User.Email</p>

            <hr />

            <h5>Bio</h5>
            <p>@(string.IsNullOrWhiteSpace(Model.User.Bio) ? "No Bio provided." : Model.User.Bio)</p>
        </div>
    </div>
</div>
