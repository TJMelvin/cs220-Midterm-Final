@page "{threadId:int}"
@model TylerMelvin_DiscussionBoard.Pages.DiscussionModel
@using Microsoft.AspNetCore.Authorization
@using TylerMelvin_DiscussionBoard.Models
@using TylerMelvin_DiscussionBoard.Helpers
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Discussion Post - " + Model.DiscussionThread.Title;
}

<div class="container">
    <div class="card mb-3">
        <div class="card-header">
            <h5 class="card-title">@Html.Raw(Model.DiscussionThread.Title) by @Model.DiscussionThread.ApplicationUser.UserName</h5>
            @if ((await AuthorizationService.AuthorizeAsync(User, Model.DiscussionThread, PolicyTypes.IsOwnerOrAdmin)).Succeeded)
            {
                <a asp-page="EditThread"
                   asp-route-id="@Model.DiscussionThread.Id"
                   class="btn btn-warning btn-sm">
                    Edit
                </a>

                <form method="post" asp-page-handler="Delete" class="d-inline">
                    <button type="submit" class="btn btn-danger btn-sm float-end">
                        Delete
                    </button>
                </form>
            }
        </div>
        <div class="card-body">
            <p class="card-text">@Html.Raw(Model.DiscussionThread.Content)</p>
            <a href="/Reply/@Model.ThreadId" class="text-decoration-none">
                <button class="btn btn-outline-primary">
                    Reply
                </button>
            </a>
            <br /><hr />
            @* Posts hierarchy *@
            @if (Model.DiscussionThread.Posts != null && Model.DiscussionThread.Posts.Count > 0)
            {
                foreach (var p in Model.DiscussionThread.Posts)
                {
                    <partial name="_PostTreeView" model="p" />
                }
            }
            else
            {
                <p>No replies yet.</p>
            }
        </div>
    </div>
</div>