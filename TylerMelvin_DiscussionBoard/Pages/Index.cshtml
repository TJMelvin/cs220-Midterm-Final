@page
@model TylerMelvin_DiscussionBoard.Pages.IndexModel
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using TylerMelvin_DiscussionBoard.Models
@using TylerMelvin_DiscussionBoard.Helpers

<div class="text-center">
    <div class="container mb-3">
        <form method="get">
            <button type="submit" asp-page="/DiscussionThreads">New Discussion Thread</button>
        </form>
    </div>

    <div class="container mt-4">
        @if (Model.DiscussionThreads.Count != 0)
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>User</th>
                        <th>Date</th>
                        <th>Posts</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DiscussionThread dt in Model.DiscussionThreads)
                    {
                        <tr>
                            <td>
                                @if ((await AuthorizationService.AuthorizeAsync(
                                                        HttpContextAccessor.HttpContext.User,
                                                        dt,
                                                        PolicyTypes.IsOwnerOrAdmin)).Succeeded)
                                {
                                    <a href="/DiscussionThreads/@dt.Id">@dt.Title</a>
                                }
                                else
                                {
                                    @dt.Title
                                }
                            </td>
                            <td>@dt.ApplicationUser.FirstName.ToString() @dt.ApplicationUser.LastName.ToString()</td>
                            <td>@dt.CreatedAt.ToLocalTime().ToString("f")</td>
                            <td><a asp-page="/Discussion" asp-route-ThreadId="@dt.Id">@dt.Posts.Count</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <h3>No threads have been created yet.</h3>
        }
    </div>
</div>
