@page
@model TylerMelvin_DiscussionBoard.Pages.IndexModel
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@using TylerMelvin_DiscussionBoard.Models
@using TylerMelvin_DiscussionBoard.Helpers

<div class="text-center">
    <div class="container mb-3">
        <form method="get">
            <button type="submit" asp-page="/DiscussionThreads">New Discussion Thread</button>
        </form>
    </div>

    <div class="container mt-4">
        @if (Model.DiscussionThreads.Count != 0)
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>User</th>
                        <th>Date Posted</th>
                        <th>Last Updated</th>
                        <th>Replies</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DiscussionThread dt in Model.DiscussionThreads)
                    {
                        <tr>
                            <td>
                                <a class="table-link" asp-page="/Discussion" asp-route-ThreadId="@dt.Id">
                                    @dt.Title
                                </a>
                            </td>
                        <td>
                            <a class="table-link" asp-page="/ProfileIndex" asp-route-id="@dt.ApplicationUser.Id">
                                    @(dt.ApplicationUser != null
                                                                ? $"{dt.ApplicationUser.FirstName} {dt.ApplicationUser.LastName}"
                                                                : "Unknown")
                            </a>
                        </td>
                            <td>@dt.CreatedAt.ToLocalTime().ToString("f")</td>
                            <td>@dt.LastUpdated.ToLocalTime().ToString("f")</td>
                            <td><a>@dt.Posts.Count</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <h3>No threads have been created yet.</h3>
        }
    </div>
</div>
